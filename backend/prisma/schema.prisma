datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  username         String        @unique
  password         String
  name             String
  // Roles: SUPERADMIN | ADMIN_PLANTA | OPERATOR | AUDITOR | USER
  role             String        @default("USER")
  // Plant assignment: "Planta 1" | "Planta 2" | "Planta 3" | "Planta UPCAST" | null (for SUPERADMIN)
  plant            String?
  currentSessionId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]
  checklists       DeviceChecklist[] @relation("ChecklistCreator")
}

model Item {
  id                 String        @id @default(uuid())
  sku                String        @unique
  name               String
  model              String?
  serialNumber       String?
  description        String?
  notes              String?
  faults             String?
  category           String?
  area               String?
  ipAddress          String?
  hasWarranty        Boolean       @default(false)
  warrantyExpiration String?
  stock              Int           @default(0)
  minStock           Int           @default(5)
  unit               String        @default("unidad")
  location           String?
  qrCodePayload      String        @unique
  plant              String        @default("Planta 2")
  isITInternal       Boolean       @default(false)
  customAttributes   String?
  bitlockerKey          String?
  devicePassword        String?
  originPlant           String?       @default("Planta 2")
  assignedTo            String?
  assignedDate          DateTime?
  assignedArea          String?
  assignedBadge         String?
  status                String        @default("ACTIVE")
  decommissionDate      DateTime?
  decommissionReason    String?
  decommissionNotes     String?
  decommissionedBy      String?
  disposalMethod        String?
  decommissionActNumber String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  transactions          Transaction[]
  maintenances          Maintenance[]
  responsivas           ResponsivaHistory[]
  loans                 DeviceLoan[]
  checklists            DeviceChecklist[]

  @@index([plant, category])
  @@index([isITInternal])
  @@index([assignedTo])
  @@index([serialNumber])
  @@index([status])
}

model Transaction {
  id         String   @id @default(uuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String
  quantity   Int
  assignedTo String?
  fromPlant  String?
  toPlant    String?
  notes      String?
  createdAt  DateTime @default(now())

  @@index([itemId])
  @@index([userId])
  @@index([createdAt])
}

model Maintenance {
  id          String   @id @default(uuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  deviceType  String
  performedBy String
  performedAt DateTime @default(now())
  nextDueDate DateTime
  checklist   String
  notes       String?
  createdAt   DateTime @default(now())

  @@index([itemId])
  @@index([nextDueDate])
}

model PurchaseOrder {
  id             String     @id @default(uuid())
  reqNumber      String?
  requisitionFor String?
  poNumber       String?
  supplier       String
  itemName       String
  category       String?
  // OPEX or CAPEX
  purchaseType   String     @default("OPEX")
  capexCodeId    String?
  capexCode      CapexCode? @relation(fields: [capexCodeId], references: [id])
  quantity       Int
  unitPrice      Float?
  totalPrice     Float?
  // EUR equivalent calculated at time of creation using active EUR rate
  amountEUR      Float?
  status         String     @default("PENDING")
  receivedDate   DateTime?
  receivedBy     String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([reqNumber])
  @@index([poNumber])
  @@index([status])
  @@index([purchaseType])
  @@index([capexCodeId])
}

// CAPEX Investment Code / Budget Line
model CapexCode {
  id             String          @id @default(uuid())
  // e.g. "CAP-2026-001"
  code           String          @unique
  description    String
  year           Int
  plant          String          // "Planta 1" | "Planta 2" | "Planta 3" | "Planta UPCAST"
  // Original approved budget in EUR
  budgetEUR      Float
  // Running total consumed in EUR (auto-updated when requisition is RECEIVED)
  consumedEUR    Float           @default(0)
  // Informational fields
  quantity       Int?
  priceEUR       Float?
  isActive       Boolean         @default(true)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([plant, year])
  @@index([code])
  @@index([isActive])
}

// System-wide configuration (exchange rates, etc.)
model SystemConfig {
  id        String   @id @default(uuid())
  // "EUR_RATE" | "USD_RATE"
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model ResponsivaHistory {
  id             String   @id @default(uuid())
  itemId         String
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  colaborador    String
  marcaModelo    String
  serie          String
  nombreEquipo   String
  accesoriosJson String
  observaciones  String?
  photoUrlsJson  String?
  signatureData  String?
  email          String?
  emailSent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([itemId])
  @@index([createdAt])
}

model DeviceLoan {
  id             String    @id @default(uuid())
  itemId         String
  item           Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrowerName   String
  borrowerArea   String?
  borrowerBadge  String?
  loanDate       DateTime  @default(now())
  expectedReturn DateTime
  actualReturn   DateTime?
  status         String    @default("ACTIVE")
  loanNotes      String?
  returnNotes    String?
  loanedBy       String
  receivedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([itemId])
  @@index([status])
  @@index([expectedReturn])
}

model DeviceChecklist {
  id             String    @id @default(uuid())
  itemId         String
  item           Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // IN_PROGRESS | COMPLETED | VOIDED
  status         String    @default("IN_PROGRESS")
  // JSON with 30 checklist items: {sectionA: [{id, label, value}], sectionB: [{id, label, value}]}
  checklistData  String    @default("{}")
  // JSON array of signatories: [{userId, userName, plant, role, timestamp, sections[]}]
  signaturesJson String    @default("[]")
  // ID of the user who created the checklist
  createdById    String
  createdBy      User      @relation("ChecklistCreator", fields: [createdById], references: [id])
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([itemId])
  @@index([status])
  @@index([createdById])
}

model ChecklistTemplate {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  plant        String?
  sectionsJson String   // JSON format: { sectionA: [{id, label}], sectionB: [{id, label}] }
  isDefault    Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([plant])
  @@index([name])
}
