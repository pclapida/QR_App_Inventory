datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  username     String        @unique
  password     String
  name         String
  role         String        @default("USER")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Item {
  id                 String        @id @default(uuid())
  sku                String        @unique
  name               String
  model              String?
  serialNumber       String?
  description        String?
  notes              String?
  faults             String?
  category           String?
  area               String?
  ipAddress          String?
  hasWarranty        Boolean       @default(false)
  warrantyExpiration String?
  stock              Int           @default(0)
  minStock           Int           @default(5)
  unit               String        @default("unidad")
  location           String?
  qrCodePayload      String        @unique
  plant              String        @default("Planta 2")
  isITInternal       Boolean       @default(false)
  customAttributes   String?
  bitlockerKey       String?
  devicePassword     String?
  assignedTo         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  transactions       Transaction[]
  maintenances       Maintenance[]
  responsivas        ResponsivaHistory[]

  @@index([plant, category])
  @@index([isITInternal])
  @@index([assignedTo])
  @@index([serialNumber])
}

model Transaction {
  id         String   @id @default(uuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String
  quantity   Int
  assignedTo String?
  fromPlant  String?
  toPlant    String?
  notes      String?
  createdAt  DateTime @default(now())

  @@index([itemId])
  @@index([userId])
  @@index([createdAt])
}

model Maintenance {
  id          String   @id @default(uuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  deviceType  String
  performedBy String
  performedAt DateTime @default(now())
  nextDueDate DateTime
  checklist   String
  notes       String?
  createdAt   DateTime @default(now())

  @@index([itemId])
  @@index([nextDueDate])
}

model PurchaseOrder {
  id             String    @id @default(uuid())
  reqNumber      String?
  requisitionFor String?
  poNumber       String?
  supplier       String
  itemName       String
  category       String?
  quantity       Int
  unitPrice      Float?
  totalPrice     Float?
  status         String    @default("PENDING")
  receivedDate   DateTime?
  receivedBy     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([reqNumber])
  @@index([poNumber])
  @@index([status])
}

model ResponsivaHistory {
  id             String   @id @default(uuid())
  itemId         String
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  colaborador    String
  marcaModelo    String
  serie          String
  nombreEquipo   String
  accesoriosJson String
  observaciones  String?
  photoUrlsJson  String?
  email          String?
  emailSent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([itemId])
  @@index([createdAt])
}
