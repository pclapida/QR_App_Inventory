# Variables de Entorno — Backend
# Copia este archivo como .env y rellena los valores reales. NUNCA subas .env al repositorio.

# Puerto del servidor API
PORT=4000

# Secreto JWT — Genera uno seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# URL de conexión a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB?schema=public
DATABASE_URL=postgresql://inventory_user:CAMBIA_ESTE_PASSWORD@localhost:5432/qr_inventory?schema=public

# (Opcional) URL del frontend para CORS. Ejemplo: http://10.85.105.15:3000
# FRONTEND_URL=http://10.85.105.15:3000
