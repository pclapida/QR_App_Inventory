# Variables para docker-compose
# Copia como .env en la raíz del proyecto y rellena los valores reales.

# Credenciales de PostgreSQL
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=CAMBIA_ESTE_PASSWORD_SEGURO
POSTGRES_DB=qr_inventory

# Secreto JWT — Genera uno: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO_DE_64_CHARS

# (Opcional) IP o dominio del frontend para CORS
# FRONTEND_URL=http://10.85.105.15:3000
